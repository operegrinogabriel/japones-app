  "erros": [
    {"id":"a01-e01","errado":"私わガブリエルです。","certo":"{私|わたし}はガブリエルです。","explicacao":"A partícula de tópico se lê wa mas se escreve は.","tipo":"は/わ"},
    {"id":"a01-e02","errado":"サンパウロわ大木だよ。","certo":"サンパウロは{大|おお}きいです。","explicacao":"は, e 大木 é árvore grande (erro de conversão). Mantenha です com quem você acabou de conhecer.","tipo":"teclado"},
    {"id":"a01-e03","errado":"始めました。","certo":"はじめまして。","explicacao":"始めました = comecei. A saudação é はじめまして, normalmente em kana.","tipo":"teclado"},
    {"id":"a01-e04","errado":"俳句が読みます。","certo":"{俳句|はいく}を{読|よ}みます。","explicacao":"O que se lê é objeto direto: を.","tipo":"partícula"},
    {"id":"a01-e05","errado":"彼の友達山へ行きます。","certo":"{友達|ともだち}と{山|やま}へ{行|い}きます。","explicacao":"Sem と a frase vira o amigo dele vai à montanha. と = com.","tipo":"partícula"},
